  "fixed_sql": [
    {
      "name": "projects",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"projects\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"path\" TEXT NOT NULL UNIQUE, \"name\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), \"last_opened_at\" INTEGER NULL, \"is_flutter\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_flutter\" IN (0, 1)), \"trusted_at\" INTEGER NULL);"
        }
      ]
    },
    {
      "name": "sessions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"sessions\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"project_id\" INTEGER NOT NULL REFERENCES projects (id) ON DELETE CASCADE, \"agent_id\" TEXT NOT NULL, \"acp_session_id\" TEXT NULL, \"title\" TEXT NOT NULL DEFAULT '', \"bypass_allowed_at\" INTEGER NULL, \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), \"updated_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)));"
        }
      ]
    },
    {
      "name": "session_events",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"session_events\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"session_id\" INTEGER NOT NULL REFERENCES sessions (id) ON DELETE CASCADE, \"seq\" INTEGER NOT NULL, \"origin\" TEXT NOT NULL, \"kind\" TEXT NOT NULL, \"payload\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), UNIQUE (\"session_id\", \"seq\"));"
        }
      ]
    },
    {
      "name": "app_settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"app_settings\" (\"key\" TEXT NOT NULL, \"value\" TEXT NOT NULL, \"updated_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), PRIMARY KEY (\"key\"));"
        }
      ]
    },
    {
      "name": "skill_states",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"skill_states\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"skill_id\" TEXT NOT NULL, \"project_id\" INTEGER NULL REFERENCES projects (id) ON DELETE CASCADE, \"enabled\" INTEGER NOT NULL CHECK (\"enabled\" IN (0, 1)), UNIQUE (\"skill_id\", \"project_id\"));"
        }
      ]
    },
    {
      "name": "mcp_servers",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"mcp_servers\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL UNIQUE, \"transport\" TEXT NOT NULL, \"config\" TEXT NOT NULL, \"enabled\" INTEGER NOT NULL DEFAULT 1 CHECK (\"enabled\" IN (0, 1)), \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)));"
        }
      ]
    },
    {
      "name": "mcp_server_states",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"mcp_server_states\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"server_key\" TEXT NOT NULL, \"project_id\" INTEGER NOT NULL REFERENCES projects (id) ON DELETE CASCADE, \"enabled\" INTEGER NOT NULL CHECK (\"enabled\" IN (0, 1)), UNIQUE (\"server_key\", \"project_id\"));"
        }
      ]
    }
  ]
